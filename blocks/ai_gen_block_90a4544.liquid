{% doc %}
  @prompt
    Create an accordion/dropdown FAQ section for the FAQ page where each question is clickable and expands to reveal the answer. Only one answer should be visible at a time (or allow multiple open). Questions should have a toggle indicator (like a + or arrow icon) that rotates when expanded. The section should pull content from the existing page content or allow questions and answers to be added as blocks in the theme editor.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-faq-accordion-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-faq-accordion__title-{{ ai_gen_id }} {
    text-align: {{ block.settings.title_alignment }};
    margin-bottom: {{ block.settings.title_spacing }}px;
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    text-transform: {{ block.settings.title_case }};
  }

  .ai-faq-accordion__items-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.item_spacing }}px;
  }

  .ai-faq-accordion__item-{{ ai_gen_id }} {
    border: {{ block.settings.item_border_width }}px solid {{ block.settings.item_border_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
    background-color: {{ block.settings.item_background_color }};
    overflow: hidden;
  }

  .ai-faq-accordion__question-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: {{ block.settings.question_padding }}px;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    color: {{ block.settings.question_color }};
    font-size: {{ block.settings.question_size }}px;
    font-weight: 600;
    transition: background-color 0.2s ease;
  }

  .ai-faq-accordion__question-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.question_hover_color }};
  }

  .ai-faq-accordion__question-text-{{ ai_gen_id }} {
    flex: 1;
    padding-right: 16px;
  }

  .ai-faq-accordion__icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    color: {{ block.settings.icon_color }};
  }

  .ai-faq-accordion__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-faq-accordion__item-{{ ai_gen_id }}.active .ai-faq-accordion__icon-{{ ai_gen_id }} {
    transform: rotate({{ block.settings.icon_rotation }}deg);
  }

  .ai-faq-accordion__answer-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
    padding: 0 {{ block.settings.question_padding }}px;
  }

  .ai-faq-accordion__item-{{ ai_gen_id }}.active .ai-faq-accordion__answer-{{ ai_gen_id }} {
    max-height: 1000px;
    padding: 0 {{ block.settings.question_padding }}px {{ block.settings.question_padding }}px;
  }

  .ai-faq-accordion__answer-content-{{ ai_gen_id }} {
    color: {{ block.settings.answer_color }};
    font-size: {{ block.settings.answer_size }}px;
    line-height: 1.6;
  }

  .ai-faq-accordion__answer-content-{{ ai_gen_id }} p {
    margin: 0 0 12px 0;
  }

  .ai-faq-accordion__answer-content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-faq-accordion-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-faq-accordion__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-faq-accordion__question-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.question_size }}px * 0.9);
      padding: {{ block.settings.question_padding | times: 0.75 }}px;
    }

    .ai-faq-accordion__answer-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.question_padding | times: 0.75 }}px;
    }

    .ai-faq-accordion__item-{{ ai_gen_id }}.active .ai-faq-accordion__answer-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.question_padding | times: 0.75 }}px {{ block.settings.question_padding | times: 0.75 }}px;
    }
  }
{% endstyle %}

<faq-accordion-{{ ai_gen_id }}
  class="ai-faq-accordion-{{ ai_gen_id }}"
  data-allow-multiple="{{ block.settings.allow_multiple_open }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.section_title != blank %}
    <h2 class="ai-faq-accordion__title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
  {% endif %}

  <div class="ai-faq-accordion__items-{{ ai_gen_id }}">
    {% for i in (1..10) %}
      {% liquid
        assign question_key = 'question_' | append: i
        assign answer_key = 'answer_' | append: i
        assign question = block.settings[question_key]
        assign answer = block.settings[answer_key]
      %}

      {% if question != blank and answer != blank %}
        <div class="ai-faq-accordion__item-{{ ai_gen_id }}" data-faq-item>
          <button
            class="ai-faq-accordion__question-{{ ai_gen_id }}"
            aria-expanded="false"
            data-faq-button
          >
            <span class="ai-faq-accordion__question-text-{{ ai_gen_id }}">{{ question }}</span>
            <span class="ai-faq-accordion__icon-{{ ai_gen_id }}">
              {% if block.settings.icon_style == 'plus' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              {% elsif block.settings.icon_style == 'chevron' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              {% else %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              {% endif %}
            </span>
          </button>
          <div class="ai-faq-accordion__answer-{{ ai_gen_id }}" data-faq-answer>
            <div class="ai-faq-accordion__answer-content-{{ ai_gen_id }}">
              {{ answer }}
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</faq-accordion-{{ ai_gen_id }}>

<script>
  (function() {
    class FaqAccordion{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.allowMultiple = this.dataset.allowMultiple === 'true';
      }

      connectedCallback() {
        this.items = this.querySelectorAll('[data-faq-item]');
        this.buttons = this.querySelectorAll('[data-faq-button]');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.buttons.forEach((button, index) => {
          button.addEventListener('click', () => {
            this.toggleItem(index);
          });
        });
      }

      toggleItem(index) {
        const item = this.items[index];
        const button = this.buttons[index];
        const isActive = item.classList.contains('active');

        if (!this.allowMultiple) {
          this.items.forEach((otherItem, otherIndex) => {
            if (otherIndex !== index) {
              otherItem.classList.remove('active');
              this.buttons[otherIndex].setAttribute('aria-expanded', 'false');
            }
          });
        }

        if (isActive) {
          item.classList.remove('active');
          button.setAttribute('aria-expanded', 'false');
        } else {
          item.classList.add('active');
          button.setAttribute('aria-expanded', 'true');
        }
      }
    }

    customElements.define('faq-accordion-{{ ai_gen_id }}', FaqAccordion{{ ai_gen_id }});
  })();
</script>

