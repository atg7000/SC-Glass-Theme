{% doc %}
  @prompt
    Create 5 accordion/dropdown FAQ blocks for the FAQ page only, each with a category title header and collapsible question/answer items. Questions expand on click with a + or arrow toggle icon. Categories are: Shipping, Returns & Exchanges, Orders & Account, Fins & Sizing, Rainbow Fin Company.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-faq-accordion-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-faq-category-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.category_spacing }}px;
  }

  .ai-faq-category-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-faq-category-header-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_title_size }}px;
    font-weight: 600;
    margin-bottom: {{ block.settings.category_title_spacing }}px;
    color: {{ block.settings.category_title_color }};
    text-transform: {{ block.settings.category_title_case }};
  }

  .ai-faq-item-{{ ai_gen_id }} {
    border-bottom: {{ block.settings.item_border_width }}px solid {{ block.settings.item_border_color }};
  }

  .ai-faq-item-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-faq-question-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: {{ block.settings.question_padding }}px 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-size: {{ block.settings.question_size }}px;
    font-weight: 500;
    color: {{ block.settings.question_color }};
    transition: color 0.3s ease;
  }

  .ai-faq-question-{{ ai_gen_id }}:hover {
    color: {{ block.settings.question_hover_color }};
  }

  .ai-faq-question-text-{{ ai_gen_id }} {
    flex: 1;
    padding-right: 16px;
  }

  .ai-faq-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    color: {{ block.settings.icon_color }};
  }

  .ai-faq-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-faq-item-{{ ai_gen_id }}.active .ai-faq-icon-{{ ai_gen_id }} {
    transform: rotate({% if block.settings.icon_style == 'plus' %}45deg{% else %}180deg{% endif %});
  }

  .ai-faq-answer-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
    padding: 0;
  }

  .ai-faq-answer-content-{{ ai_gen_id }} {
    font-size: {{ block.settings.answer_size }}px;
    line-height: 1.6;
    color: {{ block.settings.answer_color }};
  }

  .ai-faq-item-{{ ai_gen_id }}.active .ai-faq-answer-{{ ai_gen_id }} {
    max-height: 1000px;
    padding-bottom: {{ block.settings.answer_padding }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-faq-accordion-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<faq-accordion-{{ ai_gen_id }} class="ai-faq-accordion-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.category_1_enabled %}
    <div class="ai-faq-category-{{ ai_gen_id }}">
